doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Assessment
    style.
      body {
        background-color: rgb(153, 204, 50);
        margin: 0;
        padding: 0;
        font-family: 'Arial Narrow', Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
      }
      .container {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .logo {
        width: 200px;
        height: 200px;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 25px;
      }
      .logo img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
      }
      .content h3 {
        color: white;
        font-size: 26px;
        margin: 0 0 25px 0;
        font-family: 'Agency FB', Impact, sans-serif;
        letter-spacing: 1px;
      }
      button {
        background-color: white;
        color: rgb(153, 204, 50);
        border: none;
        width: 220px;
        padding: 12px 0;
        font-size: 21px;
        font-family: 'Agency FB', Impact, sans-serif;;
        border-radius: 4px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15);
        cursor: pointer;
        letter-spacing: 1px;
      }
  body
    .container
      .logo
        img(src='/images/fca-logo.JPG')
      .content
        h3 Refugee Support Program
      button(onclick="window.location.href='/form'") Register
